#!/usr/bin/env ruby
require_relative '../lib/logger'
require 'base64'
require 'json'
require 'open3'
require 'optparse'

options = {}
OptionParser.new do |opts|
  opts.on('--repo OWNER/REPO', 'Upload values for a repository other than the current checkout') { |repo| options[:repo] = repo }
end.parse!

def gh_output(*args)
  output, errors, status = Open3.capture3('gh', *args)
  raise "gh #{args.first} failed: #{errors.strip}" unless status.success?
  output
end

repo_full_name = options[:repo] || gh_output('repo', 'view', '--json', 'nameWithOwner', '-q', '.nameWithOwner').strip
raise 'Repository must be in OWNER/REPO form' unless repo_full_name.match?(/\A[\w.-]+\/[\w.-]+\z/)
repo_visibility = gh_output('api', "repos/#{repo_full_name}", '--jq', '.visibility').strip

def secret(key)
  value = ENV[key]
  raise "#{key} not found or is blank!" if value.nil? || value.strip.empty?
  value
end

def set_value(kind, name, repo, value)
  args = kind == :secret ? ['secret', 'set', '--app', 'actions'] : ['variable', 'set']
  args += ['--repo', repo, name]
  IO.popen(['gh', *args], 'w') { |stdin| stdin.write(value) }
  $?.success?
rescue Errno::EPIPE
  false
end

def upload_secrets(secrets, repo)
  uploaded = []
  secrets.each do |name|
    puts "Uploading secret #{name}"
    if set_value(:secret, name, repo, secret(name))
      uploaded << name
    else
      error "Failed to upload secret #{name}"
    end
  end
  uploaded
end

def upload_vars(vars, repo)
  uploaded = []
  vars.each do |name|
    puts "Uploading variable #{name}"
    if set_value(:variable, name, repo, secret(name))
      uploaded << name
    else
      error "Failed to upload variable #{name}"
    end
  end
  uploaded
end

def workflow_files(repo, local_repo)
  if repo == local_repo
    return Dir.glob('.github/workflows/*.{yml,yaml}').select { |file| File.file?(file) }.map { |file| File.read(file) }
  end

  response, errors, status = Open3.capture3('gh', 'api', "repos/#{repo}/contents/.github/workflows")
  return [] if !status.success? && errors.include?('404')
  raise "Unable to list workflows for #{repo}: #{errors.strip}" unless status.success?

  JSON.parse(response).select { |file| file['type'] == 'file' && file['name'].match?(/\.ya?ml\z/) }.map do |file|
    content = gh_output('api', "repos/#{repo}/contents/#{file.fetch('path')}", '--jq', '.content')
    Base64.decode64(content)
  end
end

def references_in(files, kind)
  # shortcut: only direct ${kind}.NAME references are discovered; if workflows use computed secret names, extend the parser.
  files.flat_map { |content| content.scan(/\${{\s*#{kind}\.([A-Za-z_][A-Za-z0-9_]*)/).flatten }.uniq
end

local_repo = gh_output('repo', 'view', '--json', 'nameWithOwner', '-q', '.nameWithOwner').strip
files = workflow_files(repo_full_name, local_repo)
workflow_secrets = references_in(files, 'secrets') - %w(GITHUB_TOKEN)
workflow_vars = references_in(files, 'vars')

if workflow_secrets.any?
  info "Secrets found in workflow files:"
  workflow_secrets.each do |secret|
    puts "- #{secret}"
  end
else
  info "No secrets found in workflow files."
end

info "Repository name: #{repo_full_name}"
info "Repository visibility: #{repo_visibility}"

uploaded_secrets = upload_secrets(workflow_secrets, repo_full_name)
uploaded_vars = upload_vars(workflow_vars, repo_full_name)

if uploaded_secrets.any?
  info "Secrets uploaded:"
  uploaded_secrets.each do |secret|
    puts "- #{secret}"
  end
else
  warn "No secrets uploaded."
end

if uploaded_vars.any?
  info "Variables uploaded:"
  uploaded_vars.each do |var|
    puts "- #{var}"
  end
else
  warn "No variables uploaded."
end

existing_secrets_in_github = gh_output('secret', 'list', '--app', 'actions', '--repo', repo_full_name, '--json', 'name', '-q', '.[].name').strip.split
existing_vars_in_github = gh_output('variable', 'list', '--repo', repo_full_name, '--json', 'name', '-q', '.[].name').strip.split

missing_secrets = workflow_secrets - uploaded_secrets
missing_vars = workflow_vars - uploaded_vars

if missing_secrets.any?
  error "Secrets found in workflows but not in GitHub:"
  missing_secrets.each do |secret|
    puts "- #{secret}"
  end
else
  info "All secrets uploaded successfully."
end

if missing_vars.any?
  error "Variables found in workflows but not uploaded:"
  missing_vars.each { |var| puts "- #{var}" }
end

extra_secrets = existing_secrets_in_github - workflow_secrets
if extra_secrets.any?
  warn "Secrets found in GitHub but not in workflows:"
  extra_secrets.each do |secret|
    puts "- #{secret}"
  end
  warn "Please remove them from GitHub using the following commands:"
  extra_secrets.each do |secret|
    puts " gh secret delete --app actions #{secret}"
  end
else
  info "No extra secrets found in GitHub."
end

extra_vars = existing_vars_in_github - workflow_vars
if extra_vars.any?
  warn "Variables found in GitHub but not in workflows:"
  extra_vars.each do |var|
    puts "- #{var}"
  end
  warn "Please remove them from GitHub using the following commands:"
  extra_vars.each do |var|
    puts " gh variable delete --app actions #{var}"
  end
else
  info "No extra variables found in GitHub."
end

exit 1 unless missing_secrets.empty? && missing_vars.empty?
