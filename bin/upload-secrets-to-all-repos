#!/usr/bin/env ruby
require 'json'
require 'open3'
require_relative '../lib/logger'

org = 'specmatic'
secrets_repo = 'specmatic/specmatic-secrets'
uploader = File.expand_path('upload-secrets', __dir__)

output, errors, status = Open3.capture3('gh', 'api', '--paginate', '--slurp', "/orgs/#{org}/repos?per_page=100")
unless status.success?
  error "Unable to list #{org} repositories: #{errors.strip}"
  exit 1
end

repositories = JSON.parse(output).flatten
repositories.reject! { |repo| repo.fetch('full_name') == secrets_repo }
info "Uploading workflow-referenced secrets and variables to #{repositories.length} repositories in #{org}."

failed = []
repositories.each do |repository|
  name = repository.fetch('full_name')
  info "Syncing #{name}"
  begin
    stdout, stderr, status = Open3.capture3('ruby', uploader, '--repo', name)
    unless status.success?
      diagnostics = [stdout, stderr].join("\n").gsub(/\e\[[\d;]*m/, '').lines.map(&:strip).reject(&:empty?)
      failed << { repository: name, status: status.exitstatus, diagnostics: diagnostics }
    end
  rescue StandardError => e
    failed << { repository: name, status: nil, diagnostics: ["#{e.class}: #{e.message}"] }
  end
end

if failed.any?
  error "Secret sync failed for #{failed.length} of #{repositories.length} repositories."
  failed.each do |failure|
    error "#{failure[:repository]} (exit #{failure[:status] || 'unknown'}):"
    details = failure[:diagnostics]
    details = ['Uploader exited without diagnostic output.'] if details.empty?
    details.each { |line| puts "  #{line}" }
  end
  exit 1
end

info "All #{repositories.length} repository secret and variable uploads completed successfully."
