#!/usr/bin/env ruby
require 'json'
require 'open3'
require_relative '../lib/logger'

org = 'specmatic'
secrets_repo = 'specmatic/specmatic-secrets'
uploader = File.expand_path('upload-secrets', __dir__)

output, errors, status = Open3.capture3('gh', 'api', '--paginate', '--slurp', "/orgs/#{org}/repos?per_page=100")
unless status.success?
  error "Unable to list #{org} repositories: #{errors.strip}"
  exit 1
end

repositories = JSON.parse(output).flatten
repositories.reject! { |repo| repo.fetch('full_name') == secrets_repo }
info "Uploading workflow-referenced secrets and variables to #{repositories.length} repositories in #{org}."

failed = []
repositories.each do |repository|
  name = repository.fetch('full_name')
  info "Syncing #{name}"
  unless system('ruby', uploader, '--repo', name)
    error "Secret upload failed for #{name}"
    failed << name
  end
end

if failed.any?
  error "Repositories with failed uploads: #{failed.join(', ')}"
  exit 1
end

info 'All repository secret and variable uploads completed successfully.'
