#!/usr/bin/env ruby
require_relative '../lib/logger'
require 'shellwords'
# usage:
# eval "$(source ~/.specmatic-secrets; populate-credentials)"

mappings = {
  "ORG_GRADLE_PROJECT_mavenCentralUsername" => "SPECMATIC_MAVEN_CENTRAL_USERNAME",
  "ORG_GRADLE_PROJECT_mavenCentralPassword" => "SPECMATIC_MAVEN_CENTRAL_PASSWORD",
  "ORG_GRADLE_PROJECT_signingInMemoryKey" => "SPECMATIC_GPG_PRIVATE_KEY",
  "ORG_GRADLE_PROJECT_signingInMemoryKeyId" => "SPECMATIC_GPG_KEY_ID",
  "ORG_GRADLE_PROJECT_signingInMemoryKeyPassword" => "SPECMATIC_GPG_PRIVATE_KEY_PASSPHRASE",
  "ORG_GRADLE_PROJECT_specmaticSnapshotsUsername" => "SPECMATIC_REPOSILITE_USERNAME",
  "ORG_GRADLE_PROJECT_specmaticSnapshotsPassword" => "SPECMATIC_REPOSILITE_TOKEN",
  "ORG_GRADLE_PROJECT_specmaticReleasesUsername" => "SPECMATIC_REPOSILITE_USERNAME",
  "ORG_GRADLE_PROJECT_specmaticReleasesPassword" => "SPECMATIC_REPOSILITE_TOKEN",
  "ORG_GRADLE_PROJECT_specmaticPrivateUsername" => "SPECMATIC_REPOSILITE_USERNAME",
  "ORG_GRADLE_PROJECT_specmaticPrivatePassword" => "SPECMATIC_REPOSILITE_TOKEN",
  "SPECMATIC_GITHUB_USER" => "SPECMATIC_GITHUB_USER",
  "SPECMATIC_GITHUB_TOKEN" => "SPECMATIC_GITHUB_TOKEN",
  "SPECMATIC_DOCKER_HUB_USERNAME" => "SPECMATIC_DOCKER_HUB_USERNAME",
  "SPECMATIC_DOCKER_HUB_TOKEN" => "SPECMATIC_DOCKER_HUB_TOKEN"
}

missing = []
exports = mappings.each_with_object([]) do |(key, value), exports|
  variable = ENV[value]
  if variable.nil? || variable.strip.empty?
    missing << value
    next exports
  end

  exports << "export #{key}=#{Shellwords.escape(variable)}"
end

puts exports.join("\n") unless exports.empty?
unless missing.empty?
  STDERR.puts "Missing or blank environment variables:"
  missing.uniq.each { |name| STDERR.puts "- #{name}" }
  exit 1
end
